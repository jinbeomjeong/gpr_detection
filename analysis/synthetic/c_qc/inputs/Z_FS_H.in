#title: Z_FS_H free-space library: same heights, no soil
#domain_mode: TM
#domain: 4.0 2.45 inf
#dx_dy_dz: 0.005 0.005 0.005
#time_window: 55.000e-9
#pml_cells: 20 20 0 20 20 0

#waveform: ricker 1 5e+08 src_wave
#python:
import math
i = current_model_run - 1
x = 2.0
h = round(0.05 + 0.005 * i, 3)
def snap(v):
    return round(round(v / 0.005) * 0.005, 6)
y = snap(2.1 + h)
tx = snap(x - 0.05)
rx = snap(x + 0.05)
print('#hertzian_dipole: z %s %s inf src_wave' % (repr(tx), repr(y)))
print('#rx: %s %s inf rx1 Ez' % (repr(rx), repr(y)))
#end_python:
