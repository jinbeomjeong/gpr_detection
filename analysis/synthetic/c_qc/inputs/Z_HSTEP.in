#title: Z_HSTEP per-trace antenna height (h = 0.06 if round(x, 6) < 2.0 else 0.14), soil eps 9 sigma 0.001, PEC R 0.05 top 0.60 at x 1.2 / 2.8
#domain_mode: TM
#domain: 4.0 2.45 inf
#dx_dy_dz: 0.005 0.005 0.005
#time_window: 55.000e-9
#pml_cells: 20 20 0 20 20 0

#material: 9.0 0.001 1 0 soil

#waveform: ricker 1 5e+08 src_wave
#python:
import math
i = current_model_run - 1
x = round(0.4 + 0.02 * i, 6)
h = 0.06 if round(x, 6) < 2.0 else 0.14
def snap(v):
    return round(round(v / 0.005) * 0.005, 6)
y = snap(2.1 + h)
tx = snap(x - 0.05)
rx = snap(x + 0.05)
print('#hertzian_dipole: z %s %s inf src_wave' % (repr(tx), repr(y)))
print('#rx: %s %s inf rx1 Ez' % (repr(rx), repr(y)))
#end_python:

